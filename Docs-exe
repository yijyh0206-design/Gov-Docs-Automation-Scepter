def build_part4_summary(dfs: Dict[str, pd.DataFrame]) -> pd.DataFrame:
    units = set()
    for k, df in dfs.items():
        if df is None or df.empty:
            continue
        if "承辦單位" in df.columns:
            units |= set(df["承辦單位"].dropna().astype(str))

    if not units:
        return pd.DataFrame(columns=["承辦單位"] + [cn for _, cn in PART4_COLS]).rename(columns=PART4_HEADER_RENAME)

    data = {"承辦單位": sorted(list(units), key=lambda x: sort_key_by_unit(x))}
    for _, cn in PART4_COLS:
        data[cn] = [0] * len(data["承辦單位"])
    out = pd.DataFrame(data)

    for k, cn in PART4_COLS:
        if k in dfs and dfs[k] is not None and not dfs[k].empty and "承辦單位" in dfs[k].columns:
            counts = dfs[k]["承辦單位"].value_counts()
            out[cn] = out["承辦單位"].map(lambda u: int(counts.get(u, 0)))

    has_any = out[[cn for _, cn in PART4_COLS]].sum(axis=1) > 0
    out = out[has_any].copy()

    total_row = {"承辦單位": "合計"}
    for _, cn in PART4_COLS:
        total_row[cn] = int(out[cn].sum()) if not out.empty else 0
    out = pd.concat([out, pd.DataFrame([total_row])], ignore_index=True)

    return out.rename(columns=PART4_HEADER_RENAME)

