def est_strokes(name: str) -> int:
    if not name:
        return 0
    ch = name[0]
    if ch in _STROKES:
        return _STROKES[ch]
    return 30 + (ord(ch) % 1000)  # fallback

def sort_key_by_unit(name: str):
    return (est_strokes(name), name)


