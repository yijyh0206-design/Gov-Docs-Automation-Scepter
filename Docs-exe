        if d:
            self.var_outdir.set(d)

    def clear_fields(self):
        for k in "ABCDEFG":
            self.var_path[k].set("")
            self.var_enable[k].set(True)
        self.logbox.delete("1.0", "end")
        self.log("已清除。")

    def validate_inputs(self):
        ok = True
        for k in "ABCDEFG":
            if self.var_enable[k].get():
                p = self.var_path[k].get().strip()
                if not p or not os.path.exists(p):
                    ok = False
                    self.log(f"{k} 未選檔或檔案不存在。")
        if not os.path.isdir(self.var_outdir.get().strip()):
            ok = False
            self.log("輸出資料夾不存在。")
        if ok:
            self.log("驗證通過。")
        else:
            messagebox.showwarning("驗證未通過", "請檢查上方紅字訊息。")

    # ---- 主流程 ----
    def _load_and_process(self, key: str) -> Tuple[Optional[pd.DataFrame], Optional[str]]:
        if not self.var_enable[key].get():
            return None, None
        path = self.var_path[key].get().strip()
        if not path:
            return None, None
        try:
            df_raw = read_csv_safely(path)
            self.log(f"{key} 已讀：{path}，{len(df_raw)} 筆")
            for c in df_raw.select_dtypes(include=["object"]).columns:
                df_raw[c] = normalize_str_series(df_raw[c])
            df, first_title = PROCESSORS[key](df_raw)
            self.log(f"{key} 轉換成功：{NAME_MAP[key]}，{len(df)} 筆")
            return df, first_title
        except Exception as e:
            self.log(f"{key} 讀取或轉換失敗：{e}")
            return None, None

    def convert_selected(self):
        outdir = self.var_outdir.get().strip()
        if not os.path.isdir(outdir):
            messagebox.showerror("錯誤", "輸出資料夾不存在")
            return

        # PART II：讀入→轉換（不加三列）
        dfs: Dict[str, pd.DataFrame] = {}
        first_titles: Dict[str, str] = {}
        for k in "ABCDEFG":
            df, first_title = self._load_and_process(k)
            if df is not None and not df.empty:
                dfs[k] = df
                first_titles[k] = first_title
        if not dfs:
            self.log("沒有任何清單讀入成功。")
            return

        # PART III：交互去重
        dfs = dedup_part3(dfs, self.log)

        # === 準備 CSV 與 Excel 的資料（先加三列，再各自輸出）===
        roc = roc_today_str()
        excel_sheets: Dict[str, pd.DataFrame] = {}  # for PART V

        # 各清單輸出 CSV + 收集進 Excel
        for k, df in dfs.items():
            if df is None or df.empty:
                continue
            final_df = add_three_header_rows(df, k)
            # CSV
            fname = f"{roc}_{first_titles.get(k, FIRST_TITLES.get(k, NAME_MAP.get(k,'清單')))}.csv"
            opath = os.path.join(outdir, fname)
            final_df.to_csv(opath, index=False, header=False, encoding="utf-8-sig")
            self.log(f"{k} 已輸出：{opath}")
            # 收集給 Excel（工作表）
            excel_sheets[k] = final_df

        # PART IV：各單位 × A~G 件數統計表（改名 + 三列）
        try:
            part4 = build_part4_summary(dfs)
            if part4 is not None and not part4.empty:
                part4_final = add_title_three_rows_part4(part4)
                p4name = f"{roc}_各單位_公文案件數量統計彙整.csv"
                p4path = os.path.join(outdir, p4name)
                part4_final.to_csv(p4path, index=False, header=False, encoding="utf-8-sig")
                self.log(f"PART IV 統計已輸出：{p4path}")
                excel_sheets["PART4"] = part4_final
            else:
                self.log("PART IV：統計結果為空，未輸出統計表。")
        except Exception as e:
            self.log(f"PART IV：統計失敗：{e}")

        # PART V：合併成單一 Excel（樣式＋邊框＋列高自動）
        try:
            save_to_single_excel(excel_sheets, outdir, roc, self.log)
        except Exception as e:
            self.log(f"PART V：Excel 合併失敗：{e}")

        self.log("全部完成。")

    def only_dedup(self):
        # 僅做去重預覽（不輸出）
        dfs: Dict[str, pd.DataFrame] = {}
        for k in "ABCDEFG":
            df, _ = self._load_and_process(k)
            if df is not None and not df.empty:
                dfs[k] = df
        if not dfs:
            self.log("沒有任何清單讀入成功。")
            return
        before = {k: len(v) for k, v in dfs.items()}
        dfs2 = dedup_part3(dfs, self.log)
        after = {k: len(v) for k, v in dfs2.items()}
        self.log("去重前後筆數：")
        for k in "ABCDEFG":
            if k in before:
                self.log(f"  {k}：{before[k]} → {after.get(k, 0)}")
        # PART IV 總數預覽
        self.log("PART IV 預覽（各類別總數）：")
        for k in "ABCDEFG":
            self.log(f"  {k}：{after.get(k, 0)}")


