def safe_sheet_name(name: str) -> str:
    """Excel 工作表名最長 31 字元；重複或過長時做裁切/去非法字元。"""
    invalid = set(r'[]:*?/\\')
    cleaned = ''.join(ch for ch in name if ch not in invalid)
    return cleaned[:31] if len(cleaned) > 31 else cleaned

def save_to_single_excel(sheets: Dict[str, pd.DataFrame], outdir: str, roc: str, log):
    """
    sheets: {"A": df_with_headers, ..., "PART4": df_with_headers}
    匯出成 Excel：
      - 不凍結
      - 自動欄寬
      - 文字自動換行、垂直頂端
      - 前三列：粗體、淺藍底色(#D9E1F2)
      - 第 1 列合併置中；第 2 列合併靠左
      - 所有儲存格加邊框
      - 自動列高（依內容換行）
    """
    if not sheets:
        log("PART V：沒有可匯出的工作表，略過合併 Excel。")
        return

    xlsx_name = f"{roc}_公文清單_彙整.xlsx"
    xlsx_path = os.path.join(outdir, xlsx_name)

    import openpyxl
    from openpyxl.styles import Alignment, Font, PatternFill, Border, Side
    from openpyxl.utils import get_column_letter

    thin_border = Border(
        left=Side(style="thin", color="000000"),
        right=Side(style="thin", color="000000"),
        top=Side(style="thin", color="000000"),
        bottom=Side(style="thin", color="000000")
    )

    with pd.ExcelWriter(xlsx_path, engine="openpyxl") as writer:
        # 1) 寫入所有工作表（DataFrame 已含三列表頭，不再額外加 header）
        for key, df in sheets.items():
            if df is None or df.empty:
                continue
            sheet_title = SHEET_NAME_MAP.get(key, key)
            sheet_name = safe_sheet_name(sheet_title)
            df.to_excel(writer, sheet_name=sheet_name, index=False, header=False)

        wb = writer.book
        header_fill = PatternFill(start_color="D9E1F2", end_color="D9E1F2", fill_type="solid")

        for ws in wb.worksheets:
            max_col = ws.max_column

            # 2-1) 全表格：換行 + 垂直頂端 + 邊框
            for row in ws.iter_rows(min_row=1, max_row=ws.max_row, min_col=1, max_col=max_col):
                for cell in row:
                    cur = cell.alignment or Alignment()
                    cell.alignment = Alignment(horizontal=cur.horizontal, vertical="top", wrap_text=True)
                    cell.border = thin_border

            # 2-2) 自動欄寬（以最長字元數估算）
            for col_idx in range(1, max_col + 1):
                col_letter = get_column_letter(col_idx)
                max_len = 0
                for cell in ws[col_letter]:
                    if cell.value is None:
                        continue
                    s = str(cell.value)
                    max_len = max(max_len, len(s))
                ws.column_dimensions[col_letter].width = max(8, min(80, max_len + 2))

            # 2-3) 表頭底色 & 字型（第 1~3 列）
            for r in range(1, min(3, ws.max_row) + 1):
                for c in ws[r]:
                    c.font = Font(bold=True)
                    c.fill = header_fill

            # 2-4) 合併：第 1 列整列置中；第 2 列整列靠左
            if ws.max_row >= 1:
                ws.merge_cells(start_row=1, start_column=1, end_row=1, end_column=max_col)
                a1 = ws["A1"]
                a1.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
                a1.font = Font(bold=True)
                a1.fill = header_fill
                a1.border = thin_border
            if ws.max_row >= 2:
                ws.merge_cells(start_row=2, start_column=1, end_row=2, end_column=max_col)
                a2 = ws["A2"]
                a2.alignment = Alignment(horizontal="left", vertical="center", wrap_text=True)
                a2.font = Font(bold=True)
                a2.fill = header_fill
                a2.border = thin_border

            # 2-5) 第 3 列標題置中（不合併）
            if ws.max_row >= 3:
                for cell in ws[3]:
                    cell.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
                    cell.font = Font(bold=True)
                    cell.fill = header_fill

            # 2-6) 自動列高（粗估：每 ~30 字 ≈ 一行；最小 22、最大 180）
            for r in range(1, ws.max_row + 1):
                max_len = 0
                for c in ws[r]:
                    if c.value:
                        chunks = str(c.value).split("\n")
                        max_len = max(max_len, max(len(x) for x in chunks))
                est_height = (max_len // 30 + 1) * 16
                ws.row_dimensions[r].height = max(22, min(180, est_height))

    log(f"PART V：已合併輸出 Excel（全欄邊框＋表頭樣式）：{xlsx_path}")


