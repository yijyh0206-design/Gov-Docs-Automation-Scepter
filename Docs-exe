# ================= PART III 去重 =================

def dedup_part3(dfs: Dict[str, pd.DataFrame], log) -> Dict[str, pd.DataFrame]:
    def get_set(key: str) -> set:
        if key not in dfs or dfs[key] is None or dfs[key].empty:
            return set()
        if "公文文號" not in dfs[key].columns:
            return set()
        return set(normalize_str_series(dfs[key]["公文文號"]).tolist())

    A_set, B_set, F_set, G_set = (get_set("A"), get_set("B"), get_set("F"), get_set("G"))

    # 1) 刪 A：若出現在 F 或 G
    remove_in_A = (A_set & F_set) | (A_set & G_set)
    if remove_in_A and "A" in dfs and not dfs["A"].empty and "公文文號" in dfs["A"].columns:
        before = len(dfs["A"])
        dfs["A"] = dfs["A"][~dfs["A"]["公文文號"].astype(str).isin(remove_in_A)].copy()
        dfs["A"] = reindex_serial(dfs["A"])
        log(f"PART III：A 與 F/G 去重，從 A 刪除 {before - len(dfs['A'])} 筆。")

    # 2) 刪 F/G：若出現在 B
    if B_set:
        for key in ("F", "G"):
            if key in dfs and dfs[key] is not None and not dfs[key].empty and "公文文號" in dfs[key].columns:
                before = len(dfs[key])
                dfs[key] = dfs[key][~dfs[key]["公文文號"].astype(str).isin(B_set)].copy()
                dfs[key] = reindex_serial(dfs[key])
                log(f"PART III：{key} 與 B 去重，從 {key} 刪除 {before - len(dfs[key])} 筆。")

    return dfs


